# Official bot token from Developer Portal > Your Application > Bot.
# Startup verifies it with Discord using Bot authentication. Personal user
# tokens, OAuth2 Bearer credentials, and unrelated API keys are rejected.
DISCORD_TOKEN=
SERVER_ID=
CHANNEL_ID=
AUTHORIZED_USER_ID=

# Optional values
TRIGGER=,with all
ACTION_ONE=,rob uid
ACTION_TWO=,dep all
ACTION_DELAY_MS=1000
